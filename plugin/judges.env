# Environment for the cBioPortal Ask Muse demo.
#
# bootstrap.sh copies this to agentic-setup/.env on first run.
# META_API_KEY is left blank on purpose: the setup agent asks you for it,
# or run ./set_meta_key.sh yourself. It is never stored in this repository.
#
# The AlphaGenome key below is shared for judging only. Research use only,
# non-commercial; outputs must not be used to train other models.

# --- Meta Model API (Ask Muse) — you supply this --------------------------
META_API_KEY=
MUSE_WONDER_API_URL=https://api.meta.ai/v1
MUSE_PROVIDER=meta
MUSE_REASONING_EFFORT=high

# --- AlphaGenome (variant scoring and the Colab notebook) -----------------
ALPHA_GENOME_API_KEY=AIzaSyDb3-4AWZPzmccV5CDT_GBXIKANop8UAzI

# --- Branch the "Open in Colab" link points at ----------------------------
# Defaults to w6-muse-copilot where the hackathon cookbook and muse_tools live.
# Sidecar checks raw GitHub & main branch if w6-muse-copilot is missing or rate limited.
COLAB_NOTEBOOK_REF=w6-muse-copilot
COLAB_NOTEBOOK_REPO=DixitPatel/alphagenome_sidecar
