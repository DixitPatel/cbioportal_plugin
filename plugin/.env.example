# Copy to agentic-setup/.env and fill in. Never commit the filled-in file.

# Meta Model API — powers Ask Muse. Format: LLM|{numeric_id}|{secret}
META_API_KEY=
MUSE_WONDER_API_URL=https://api.meta.ai/v1

# AlphaGenome (Google DeepMind). Research use only, non-commercial.
# https://deepmind.google.com/science/alphagenome
ALPHA_GENOME_API_KEY=AIzaSyDb3-4AWZPzmccV5CDT_GBXIKANop8UAzI

# Branch and repository the "Open in Colab" link points at.
COLAB_NOTEBOOK_REF=w6-muse-copilot
COLAB_NOTEBOOK_REPO=DixitPatel/alphagenome_sidecar

# --- Optional overrides -------------------------------------------------
# lib/env.sh sets all three automatically. Set them here only to relocate.
#
# The OncoTree to UBERON map is in no repository, so the plugin ships it.
# Without it the stack starts normally but tissue lookup returns nothing and
# the Colab flow answers 422.
# ONCOTREE_MAP_PATH=<plugin>/contracts/oncotree_to_uberon.json
# COPILOT_KB_DIR=<workspace>/logs/copilot_kb
# ALPHAGENOME_DEBUG_LOG=<workspace>/logs/alphagenome_pipeline_debug.log
